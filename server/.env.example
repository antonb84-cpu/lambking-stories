# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas — replace <user>, <password>, <cluster>, <database>
MONGO_URI=mongodb+srv://user:<pass>@cluster0.lhlvowv.mongodb.net/?appName=Cluster0&retryWrites=true&w=majority
MONGO_DB_NAME=main_db

# Redis — Upstash / Render Redis / local
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CACHE_TTL_SECONDS=600

# Admin UI basic-auth
ADMIN_USER=
ADMIN_PASSWORD=

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Per-client API keys for the public read endpoints. Format:
#   CLIENT_KEYS=tauri:<key>,pages:<key>,adminui:<key>
# Each pair is `<name>:<key>`. Names are free-form, used in logs only;
# keys are what each client ships baked into its build (see VITE_CLIENT_KEY
# in src/.env.example, server/adminUI/.env.example, and src-tauri/.env.*).
# Generate keys with `openssl rand -hex 32` (or any other entropy source).
# Leave empty to disable the gate — useful for local dev where you don't
# want to provision keys upfront.
# IMPORTANT: these are NOT secrets. They live inside public clients (APK,
# Pages JS bundle) and serve as attribution + a CORS bypass channel only.
CLIENT_KEYS=

# Anonymous usage tracking for the /admin/usage dashboard. The Tauri app
# (Android / iOS) sends an `X-User-Uuid` header (a random UUID it keeps in
# localStorage) and the server stores one row per user per calendar day — no
# request log, no personal data. Web and Electron builds send no id and are
# not counted.
# USAGE_TIMEZONE is the IANA zone the daily buckets are cut on.
USAGE_TRACKING_ENABLED=true
USAGE_TIMEZONE=Europe/Berlin

# Paths (absolute or relative to server/)
AUDIOBOOKS_DIR=./audiobooks
UPLOADS_DIR=./uploads

# Translation model cache (optional)
HF_HOME=./.cache/huggingface
TRANSLATION_ENABLED=true
# ONNX weight precision: fp32 | fp16 | q8 | q4 (q8 is default, ~80 MB per pair)
TRANSLATION_DTYPE=q8

# Public base URL used to construct asset URLs returned by upload endpoints
PUBLIC_BASE_URL=http://localhost:4000

# Sentry crash reporting — leave blank to disable.
# Create two projects on sentry.io: "kanaan-stories-server" (Node/Express) and "kanaan-stories-adminui" (Vue).
# Get each DSN from Settings → Projects → <project> → Client Keys.
SENTRY_DSN=
# VITE_ prefix is required so Vite inlines it into the admin UI build.
VITE_SENTRY_DSN=
# Optional: set to the current git SHA in CI to tag events with a release.
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=

# AdminUI build-time client key. Sent as `X-Client-Key` so the BookBrowser
# dropdown's GET /api/books call clears the public-reads gate. Match the
# `adminui:<key>` entry in CLIENT_KEYS above. Vite's loadEnv() in
# server/adminUI/vite.config.ts reads this file (parent of adminUI), so
# this is where the AdminUI build picks the value up.
VITE_CLIENT_KEY=
